{
  "name": "d-d-adventure-sheet-api",
  "version": "1.0.0",
  "description": "D&D Adventure Sheet API",
  "main": "src/4-framework/http/server.ts",
  "scripts": {
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/4-framework/http/server.ts",
    "dev:http": "ts-node-dev -r tsconfig-paths/register --transpile-only src/4-framework/http/server.ts",
    "dev": "ts-node-dev -r tsconfig-paths/register --transpile-only src/4-framework/http/server.ts",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "prettier": "prettier --list-different './**/**/*.{js,ts}'",
    "typecheck": "tsc --noEmit",
    "test": "jest -t",
    "test:coverage": "jest . --coverage",
    "pipe:check": "yarn typecheck & yarn test & yarn lint:fix",
    "prepare": "husky install",
    "migration": "ts-node -r tsconfig-paths/register --project ./tsconfig.json ./node_modules/.bin/typeorm",
    "migration:up": "yarn migration migration:run -d devops/typeorm.config.ts",
    "migration:down": "yarn migration migration:revert -d devops/typeorm.config.ts",
    "migration:create": "bash -c 'yarn migration migration:create devops/migrations/relational-database/$0'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "inversify": "^6.0.2",
    "pg": "^8.5.1",
    "pg-hstore": "^2.3.3",
    "reflect-metadata": "^0.1.13",
    "source-map-support": "^0.5.19",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@serverless/typescript": "^2.23.0",
    "@types/aws-lambda": "^8.10.71",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^26.0.20",
    "@types/node": "^14.14.25",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "34.0.1",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "husky": "^8.0.3",
    "jest": "^26.6.3",
    "json-schema-to-ts": "^1.5.0",
    "lint-staged": "^13.1.2",
    "prettier": "^2.8.8",
    "ts-jest": "^26.5.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths-webpack-plugin": "^3.3.0",
    "typescript": "^4.1.3",
    "webpack": "^5.89.0",
    "webpack-node-externals": "^2.5.2"
  },
  "jest": {
    "verbose": true,
    "bail": false,
    "collectCoverage": false,
    "preset": "ts-jest",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "json",
      "json-summary",
      "lcov",
      "text",
      "clover"
    ],
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "node"
    ],
    "testRegex": "/.*\\.(int)|(unit)\\.[jt]s$",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@domain/(.*)": "<rootDir>/src/1-domain/$1",
      "@business/(.*)": "<rootDir>/src/2-business/$1",
      "@controller/(.*)": "<rootDir>/src/3-controller/$1",
      "@framework/(.*)": "<rootDir>/src/4-framework/$1",
      "@shared/(.*)": "<rootDir>/src/shared/$1",
      "@test/(.*)": "<rootDir>/test/$1"
    }
  }
}
